{
  "name": "qvideochat-client",
  "version": "1.4.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "build:electron": "node scripts/build-electron.mjs",
    "electron": "electron .",
    "electron:dev": "npm run build:electron && electron .",
    "dist:portable": "npm run build:electron && electron-builder --win portable --publish never",
    "start": "next start --port 3000",
    "lint": "next lint"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@huggingface/transformers": "^4.2.0",
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/face_mesh": "^0.4.1633559619",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@pixiv/three-vrm": "^3.0.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.0",
    "three": "^0.173.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.173.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "com.qvideochat.desktop",
    "productName": "QVideoChat",
    "artifactName": "${productName}-Portable-${version}.${ext}",
    "asar": false,
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "electron/assets"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules",
      "!node_modules/**"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ],
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "QVideoChat-Portable-${version}.exe",
      "unicode": true,
      "requestExecutionLevel": "user"
    }
  }
}
