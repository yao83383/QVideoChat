FROM node:24-alpine AS builder
WORKDIR /build
RUN npm config set registry https://registry.npmmirror.com
COPY client/package.json client/package-lock.json* ./
RUN npm ci
COPY client/ .

ARG NEXT_PUBLIC_SERVER_URL=http://localhost:3001
ARG NEXT_PUBLIC_SOCKET_PATH=/socket.io
ARG NEXT_PUBLIC_BASE_PATH=/q
ENV NEXT_PUBLIC_SERVER_URL=${NEXT_PUBLIC_SERVER_URL}
ENV NEXT_PUBLIC_SOCKET_PATH=${NEXT_PUBLIC_SOCKET_PATH}
ENV NEXT_PUBLIC_BASE_PATH=${NEXT_PUBLIC_BASE_PATH}
RUN sed -i "s|basePath: \"/q\"|basePath: \"${NEXT_PUBLIC_BASE_PATH}\"|g" next.config.ts
RUN rm -f .env.local .env .env.production
RUN npm run build

FROM node:24-alpine
WORKDIR /app
COPY --from=builder /build/package.json ./
COPY --from=builder /build/node_modules ./node_modules
COPY --from=builder /build/.next ./.next
COPY --from=builder /build/public ./public
COPY --from=builder /build/next.config.ts ./
EXPOSE 3000
CMD ["npx", "next", "start", "-p", "3000"]
